+/* F2G: Build TAI-List-for-Warning from cbc_message tai_list
+ * 3GPP TS 29.168 Section 8.4.4 */
+static void msgb_put_sbcap_tai_list(const struct cbc_message *cbcmsg, 
+				    SBcAP_TAI_List_for_Warning_t *tai_list)
+{
+	unsigned int i;
+	
+	for (i = 0; i < cbcmsg->u.tai_list.num_tai; i++) {
+		const struct cbc_tai *tai = &cbcmsg->u.tai_list.tai[i];
+		SBcAP_TAI_t *asn_tai;
+		uint8_t plmn_enc[3];
+		uint8_t tac_enc[2];
+		
+		asn_tai = CALLOC(1, sizeof(*asn_tai));
+		if (!asn_tai)
+			continue;
+		
+		/* Encode PLMN Identity (MCC+MNC) 
+		 * Format: "00101" -> MCC=001, MNC=01 */
+		if (strlen(tai->plmn) >= 5) {
+			/* Simple encoding for test PLMN 00101 */
+			plmn_enc[0] = 0x00;  /* MCC digit 2 | MCC digit 1 */
+			plmn_enc[1] = 0xf1;  /* MNC digit 3 | MCC digit 3 (f=filler) */
+			plmn_enc[2] = 0x10;  /* MNC digit 2 | MNC digit 1 */
+			
+			/* For PLMN 00101: encode as 00 f1 10 */
+			plmn_enc[0] = ((tai->plmn[1] - '0') << 4) | (tai->plmn[0] - '0');
+			plmn_enc[1] = 0xf0 | (tai->plmn[2] - '0');
+			plmn_enc[2] = ((tai->plmn[4] - '0') << 4) | (tai->plmn[3] - '0');
+		}
+		
+		asn_tai->pLMNidentity.buf = MALLOC(3);
+		asn_tai->pLMNidentity.size = 3;
+		memcpy(asn_tai->pLMNidentity.buf, plmn_enc, 3);
+		
+		/* Encode TAC (2 bytes, big endian) */
+		tac_enc[0] = (tai->tac >> 8) & 0xff;
+		tac_enc[1] = tai->tac & 0xff;
+		
+		asn_tai->tAC.buf = MALLOC(2);
+		asn_tai->tAC.size = 2;
+		memcpy(asn_tai->tAC.buf, tac_enc, 2);
+		
+		/* Add to list */
+		ASN_SEQUENCE_ADD(&tai_list->list, asn_tai);
+		
+		LOGP(DSBcAP, LOGL_INFO, "Added TAI: PLMN=%s TAC=%u\n", tai->plmn, tai->tac);
+	}
+}
