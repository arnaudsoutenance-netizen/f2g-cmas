+/* Maximum number of TAIs in a scope_tai list */
+#define CBC_MAX_TAI 16
+
+/* TAI (Tracking Area Identity) for scope_tai */
+struct cbc_tai {
+	char plmn[7];	/* MCC+MNC as string, e.g. "00101" */
+	uint16_t tac;	/* Tracking Area Code */
+};
+
 enum cbc_message_scope {
 	CBC_MSG_SCOPE_PLMN,
+	CBC_MSG_SCOPE_TAI,		/* F2G: List of TAIs (3GPP TS 29.168) */
+	CBC_MSG_SCOPE_EUTRAN_CGI,	/* List of cells (future) */
 	/* FIXME: more local/regional scopes than PLMN-wide */
 };
 
@@ -72,7 +85,12 @@ struct cbc_message {
 	uint16_t num_bcast;		/* number of broadcasts requested (0=unlimited) */
 
 	enum cbc_message_scope scope;
-	/* FIXME: data for other scopes than PLMN-wide */
+	/* F2G: TAI list for CBC_MSG_SCOPE_TAI */
+	union {
+		struct {
+			struct cbc_tai tai[CBC_MAX_TAI];
+			unsigned int num_tai;
