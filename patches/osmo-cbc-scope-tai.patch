diff --git a/src/rest_api.c b/src/rest_api.c
--- a/src/rest_api.c
+++ b/src/rest_api.c
@@ -520,12 +520,53 @@ static int json2cbc_message(struct cbc_message *out, void *ctx, json_t *in, cons
 
 	/* [Geographic] Scope (M) */
 	jtmp = json_object_get(in, "scope");
 	if (!jtmp) {
 		*errstr = "CBCMSG 'scope' is mandatory";
 		return -EINVAL;
 	}
 
-	if ((jtmp = json_object_get(jtmp, "scope_plmn"))) {
+	json_t *jtai = json_object_get(jtmp, "scope_tai");
+	json_t *jplmn = json_object_get(jtmp, "scope_plmn");
+	
+	if (jtai && json_is_object(jtai)) {
+		/* F2G: Parse scope_tai - List of TAIs */
+		out->scope = CBC_MSG_SCOPE_TAI;
+		out->u.tai_list.num_tai = 0;
+		
+		json_t *jtai_list = json_object_get(jtai, "tai_list");
+		if (jtai_list && json_is_array(jtai_list)) {
+			size_t idx;
+			json_t *jtai_entry;
+			json_array_foreach(jtai_list, idx, jtai_entry) {
+				if (out->u.tai_list.num_tai >= CBC_MAX_TAI) {
+					*errstr = "CBCMSG 'scope_tai' too many TAIs (max 16)";
+					return -EINVAL;
+				}
+				
+				const char *plmn = json_string_value(json_object_get(jtai_entry, "plmn"));
+				json_t *jtac = json_object_get(jtai_entry, "tac");
+				
+				if (!plmn || !jtac) {
+					*errstr = "CBCMSG 'scope_tai' entry missing plmn or tac";
+					return -EINVAL;
+				}
+				
+				struct cbc_tai *tai = &out->u.tai_list.tai[out->u.tai_list.num_tai];
+				strncpy(tai->plmn, plmn, sizeof(tai->plmn) - 1);
+				tai->tac = json_integer_value(jtac);
+				out->u.tai_list.num_tai++;
+			}
+		} else {
+			*errstr = "CBCMSG 'scope_tai' requires 'tai_list' array";
+			return -EINVAL;
+		}
+		
+		if (out->u.tai_list.num_tai == 0) {
+			*errstr = "CBCMSG 'scope_tai' tai_list is empty";
+			return -EINVAL;
+		}
+	} else if (jplmn) {
 		out->scope = CBC_MSG_SCOPE_PLMN;
 	} else {
-		*errstr = "CBCMSG only 'scope_plmn' supported";
+		*errstr = "CBCMSG 'scope' must be 'scope_plmn' or 'scope_tai'";
 		return -EINVAL;
 	}
 
