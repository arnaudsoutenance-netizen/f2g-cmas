+				LOGP(DREST, LOGL_INFO, "scope_tai: PLMN=%s TAC=%u\n", tai->plmn, tai->tac);
+			}
+		} else {
+			*errstr = "CBCMSG 'scope_tai' requires 'tai_list' array";
+			return -EINVAL;
+		}
+		
+		if (out->tai_list.num_tai == 0) {
+			*errstr = "CBCMSG 'scope_tai' tai_list is empty";
+			return -EINVAL;
+		}
+		LOGP(DREST, LOGL_INFO, "Parsed scope_tai with %u TAI(s)\n", out->tai_list.num_tai);
+	} else if (jplmn) {
 		out->scope = CBC_MSG_SCOPE_PLMN;
 	} else {
-		*errstr = "CBCMSG only 'scope_plmn' supported";
+		*errstr = "CBCMSG 'scope' must be 'scope_plmn' or 'scope_tai'";
 		return -EINVAL;
 	}
 
