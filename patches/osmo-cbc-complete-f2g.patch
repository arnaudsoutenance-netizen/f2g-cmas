+				
+				struct cbc_tai *tai = &out->tai_list.tai[out->tai_list.num_tai];
+				strncpy(tai->plmn, plmn, sizeof(tai->plmn) - 1);
+				tai->plmn[sizeof(tai->plmn) - 1] = '\0';
+				tai->tac = json_integer_value(jtac);
+				out->tai_list.num_tai++;
