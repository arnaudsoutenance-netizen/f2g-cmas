  */
+/* F2G: Convert PLMN string to TBCD format for SBc-AP List-of-TAIs */
+static void plmn_str_to_tbcd(const char *plmn, uint8_t *out)
+{
+	int d[6] = {0}, n = (int)strlen(plmn), i;
+	for (i = 0; i < n && i < 6; i++)
+		d[i] = plmn[i] - '0';
+	out[0] = (uint8_t)((d[1] << 4) | d[0]);
+	out[1] = (uint8_t)(((n == 6 ? d[5] : 0xF) << 4) | d[2]);
+	out[2] = (uint8_t)((d[4] << 4) | d[3]);
+}
