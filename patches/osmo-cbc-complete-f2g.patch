+/* F2G: Calculate expiration timeout in seconds based on num_bcast and rep_period */
+static unsigned int calc_expiration_timeout(struct cbc_message *cbcmsg)
+{
+	unsigned int timeout_sec;
+	
+	/* If num_bcast is 0 (unlimited) or not set, don't set expiration timer */
+	if (cbcmsg->num_bcast == 0)
+		return 0;
+	
+	/* rep_period is the repetition period in seconds as provided by REST API */
+	/* timeout = num_bcast * rep_period */
+	timeout_sec = cbcmsg->num_bcast * cbcmsg->rep_period;
+	
+	/* Add 5 seconds margin for processing delays */
+	return timeout_sec + 5;
+}
